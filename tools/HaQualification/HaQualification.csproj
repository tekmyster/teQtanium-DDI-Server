<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestoreSources>$(MSBuildThisFileDirectory)offline-packages</RestoreSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="DnsServerCore"><HintPath>$(AcceptedRuntime)/DnsServerCore.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireAcceptedRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AcceptedRuntime)/DnsServerCore.dll')" Text="Set AcceptedRuntime to the exact reviewed runtime." />
  </Target>
</Project>
